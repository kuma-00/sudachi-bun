{
  "name": "sudachi-bun",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/setup-native.ts && bash scripts/setup-hooks.sh",
    "setup:dict": "bun scripts/setup-dict.ts",
    "setup:hooks": "bash scripts/setup-hooks.sh",
    "setup:hooks:force": "bash scripts/setup-hooks.sh --force",
    "release": "bun scripts/release.ts",
    "biome:check": "biome check .",
    "biome:write": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
